{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/ai-instructions.md"
  ],
  "small_model": "github-copilot/claude-sonnet-5",
  "permission": {
    "bash": {
      "*": "ask",
      "python scripts/gate.py*": "allow",
      "python3 scripts/gate.py*": "allow",
      "python scripts/check_opencode.py*": "allow",
      "python3 scripts/check_opencode.py*": "allow",
      "python scripts/check_docs.py*": "allow",
      "python3 scripts/check_docs.py*": "allow",
      "python scripts/test_tooling.py*": "allow",
      "python3 scripts/test_tooling.py*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rev-parse*": "allow",
      "git symbolic-ref*": "allow",
      "git merge-base*": "allow",
      "git ls-files*": "allow",
      "git branch*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny"
    },
    "external_directory": "deny"
  },
  "agent": {
    "plan": {
      "model": "github-copilot/claude-opus-5"
    },
    "explore": {
      "model": "github-copilot/claude-sonnet-5"
    }
  }
}
